tree = {
    "A": ["B", "C"],
    "B": ["D", "E"], "C": ["F", "G"],
    "D": [3, 5], "E": [6, 9],
    "F": [1, 2], "G": [0, -1]
}

def alphabeta(node, maximizing, alpha, beta):
    if isinstance(node, int):
        return node
    if maximizing:
        value = -float("inf")
        for child in tree[node]:
            value = max(value, alphabeta(child, False, alpha, beta))
            alpha = max(alpha, value)
            if alpha >= beta:
                break
        return value
    else:
        value = float("inf")
        for child in tree[node]:
            value = min(value, alphabeta(child, True, alpha, beta))
            beta = min(beta, value)
            if beta <= alpha:
                break
        return value

print("Best value:", alphabeta("A", True, -float("inf"), float("inf")))

from collections import deque

def water_jug_bfs(capacity_a, capacity_b, target):
    queue = deque([(0, 0, [])])
    visited = set([(0, 0)])
    
    while queue:
        a, b, path = queue.popleft()
        
        if a == target or b == target:
            return path + [(a, b, "Target Reached")]
            
        # Possible states and actions
        states = [
            (capacity_a, b, "Fill Jug A"),
            (a, capacity_b, "Fill Jug B"),
            (0, b, "Empty Jug A"),
            (a, 0, "Empty Jug B"),
            (a - min(a, capacity_b - b), b + min(a, capacity_b - b), "Pour Jug A to Jug B"),
            (a + min(b, capacity_a - a), b - min(b, capacity_a - a), "Pour Jug B to Jug A")
        ]
        
        for next_a, next_b, action in states:
            if (next_a, next_b) not in visited:
                visited.add((next_a, next_b))
                queue.append((next_a, next_b, path + [(a, b, action)]))
                
    return None

# Example Usage:
if __name__ == "__main__":
    jug_a_cap = 4
    jug_b_cap = 3
    target_amount = 2
    
    solution = water_jug_bfs(jug_a_cap, jug_b_cap, target_amount)
    if solution:
        print(f"Solution found in {len(solution)} steps:")
        for idx, (a, b, action) in enumerate(solution):
            print(f"Step {idx}: {action} -> Jug A: {a}L, Jug B: {b}L")
    else:
        print("No solution found.")
